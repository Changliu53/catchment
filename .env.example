# Copy to .env.local. Nothing here is required to run the app: without any of
# it, `CATCHMENT_DATA=fixture npm run dev` serves the whole analysis from a
# sampled copy of the real table.

# --- data ---------------------------------------------------------------
# The full 2,830 rows, read once per server instance and held in memory.
# Any Postgres with the schema loaded; `postgresql://…neon.tech/…` switches
# the driver to Neon's HTTP transport automatically.
DATABASE_URL=

# Serve the sampled dataset instead, with no database at all.
# CATCHMENT_DATA=fixture

# --- free-text questions ------------------------------------------------
# Only needed for questions nobody has asked before. The eight preset
# questions ship with their plans and never call a model.
ANTHROPIC_API_KEY=

# --- accounts (all four, or accounts stay off) --------------------------
# Absent, the app runs the entire analysis and never offers to save one.
# BETTER_AUTH_SECRET=   # openssl rand -base64 32
# BETTER_AUTH_URL=      # the canonical origin, e.g. https://example.vercel.app
# GITHUB_CLIENT_ID=     # an OAuth app whose callback is <BETTER_AUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_SECRET=

# --- tests ---------------------------------------------------------------
# A migrated, throwaway Postgres for the signed-in end-to-end project.
# E2E_DATABASE_URL=postgresql://postgres@localhost:5432/catchment_test
